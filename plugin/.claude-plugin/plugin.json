{
  "name": "harness",
  "version": "0.1.0",
  "description": "Stack-agnostic skills and subagents for shipping, Live writes, monitoring and verification, layered on Matt Pocock's skills.",
  "author": {
    "name": "Nathan Scheele",
    "url": "https://github.com/nathan-scheele"
  },
  "homepage": "https://github.com/nathan-scheele/claude-harness",
  "repository": "https://github.com/nathan-scheele/claude-harness",
  "license": "MIT",
  "keywords": [
    "engineering",
    "skills",
    "subagents",
    "shipping",
    "verification",
    "standards"
  ],
  "skills": [
    "./skills/setup-harness",
    "./skills/standards",
    "./skills/close-session",
    "./skills/gated-write",
    "./skills/run-monitor",
    "./skills/ship-and-land",
    "./skills/issue-prompts",
    "./skills/guided-human-step"
  ],
  "agents": [
    "./agents/live-verifier.md",
    "./agents/data-digest.md",
    "./agents/integration-reviewer.md"
  ],
  "mcpServers": {
    "browser": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@1.10.1",
        "--user-data-dir=${CLAUDE_PLUGIN_DATA}/browser-profile"
      ]
    }
  },
  "experimental": {
    "evals": "evals"
  }
}
