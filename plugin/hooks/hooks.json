{
  "description": "Keeps the live-verifier subagent's Bash read-only. Other agents and the main session are not affected.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/live-verifier-guard.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
