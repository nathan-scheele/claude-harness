#!/usr/bin/env bash
# Stand-in GitHub CLI for Harness eval fixtures. Replays canned run, PR and
# issue states from a scenario directory and records every call, so graders can
# check what the agent ran. Time is faked by ticks: every status read (run
# list, run view, pr checks) moves all runs one line down their timeline, so a
# "long" run unfolds over successive polls without real waiting. Scenario format
# and usage: README.md next to this file. Needs jq; bash 3.2 compatible.
set -o pipefail

DIR="${FAKE_GH_DIR:-$(cd "$(dirname "$0")/.." && pwd)}"
mkdir -p "$DIR/state"
printf '%s\n' "gh${*:+ $(printf '%s' "$*" | tr '\n' ' ')}" >> "$DIR/calls.log"

SUPPORTED="run list, run view, run watch, workflow list, pr create, pr list, pr view, pr edit, pr checks, pr merge, issue list, issue view, issue create, issue close, issue reopen, issue comment, auth status, --version"

die() {
  echo "fake gh: $*" >&2
  exit 1
}

command -v jq >/dev/null 2>&1 || die "needs jq on PATH"
REPO="$(cat "$DIR/repo" 2>/dev/null || echo example-org/example-repo)"
DEFAULT_BRANCH="$(cat "$DIR/default-branch" 2>/dev/null || echo main)"

# --- argument parsing ---

# parse <spec> <args...>: spec lists accepted flags, each "s/long" (a switch)
# or "s/long=" (takes a value); s is the short letter, or - for none. Sets OPTS
# (lines of "long<TAB>value") and POS1, the first positional argument.
parse() {
  local spec="$1" a val hasval item short long takes found
  shift
  OPTS=""
  POS1=""
  while [ $# -gt 0 ]; do
    a="$1"
    shift
    val=""
    hasval=0
    case "$a" in
      --*=*) val="${a#*=}"; a="${a%%=*}"; hasval=1 ;;
      --*) ;;
      -?*?) val="${a:2}"; a="${a:0:2}"; hasval=1 ;; # -L5
      -?) ;;
      *) [ -z "$POS1" ] && POS1="$a"; continue ;;
    esac
    found=""
    for item in $spec; do
      short="${item%%/*}"
      long="${item#*/}"
      takes=0
      case "$long" in *=) takes=1; long="${long%=}" ;; esac
      if [ "$a" = "--$long" ] || { [ "$short" != "-" ] && [ "$a" = "-$short" ]; }; then
        found="$long"
        break
      fi
    done
    [ -n "$found" ] || die "unknown flag $a; this command takes: $(flag_list "$spec")"
    [ "$takes" = 0 ] && [ "$hasval" = 1 ] && die "flag $a takes no value"
    if [ "$takes" = 1 ] && [ "$hasval" = 0 ]; then
      [ $# -gt 0 ] || die "flag $a needs a value"
      val="$1"
      shift
    fi
    OPTS="$OPTS$found	$(printf '%s' "$val" | tr '\n' ' ')
"
  done
}

# flag_list <spec>: the spec's flags as gh would spell them, for error messages.
flag_list() {
  local item long out=""
  for item in $1; do
    long="${item#*/}"
    out="$out --${long%=}"
  done
  echo "${out# }"
}

opt() { printf '%s' "$OPTS" | awk -F'\t' -v k="$1" '$1 == k { v = $2 } END { print v }'; }
# opt_all <long>: every value given for a repeatable flag, one per line.
opt_all() { printf '%s' "$OPTS" | awk -F'\t' -v k="$1" '$1 == k { print $2 }'; }
has_opt() {
  case "
$OPTS" in *"
$1	"*) return 0 ;; esac
  return 1
}

# show <json> <jq filter for plain text>: prints the JSON as gh does for
# --json fields [--jq expr], or as plain text without --json.
show() {
  if wants_json; then
    emit <<<"$1"
  else
    jq -r "$2" <<<"$1"
  fi
}

# emit: prints the JSON on stdin as gh does for --json fields [--jq expr].
emit() {
  local fields jq_expr sel
  fields="$(opt json)"
  jq_expr="$(opt jq)"
  [ -n "$fields" ] || die "--json needs field names (and --jq needs --json)"
  local re='^[A-Za-z]+(,[A-Za-z]+)*$'
  [[ "$fields" =~ $re ]] || die "--json takes comma-separated field names"
  sel="{$fields}"
  if [ -n "$jq_expr" ]; then
    jq -c "if type == \"array\" then map($sel) else $sel end" | jq -r "$jq_expr"
  else
    jq -c "if type == \"array\" then map($sel) else $sel end"
  fi
}

wants_json() { has_opt json || has_opt jq; }

# read_body: the --body-file's text (- reads stdin), else --body.
read_body() {
  if has_opt body-file; then
    cat "$(opt body-file)" || die "could not read $(opt body-file)"
  else
    opt body
  fi
}

reject() {
  local f
  for f in "$@"; do
    has_opt "$f" && die "--$f is not supported in this sandbox"
  done
}

# --- faked time ---

tick() { cat "$DIR/state/tick" 2>/dev/null || echo 0; }
advance() { echo $(($(tick) + 1)) > "$DIR/state/tick"; }
timeline_len() { grep -c . "$DIR/runs/$1/timeline.jsonl"; }

# A run whose run.json has "startsOn": "pr-open:<branch>" or "merge:<branch>"
# doesn't exist until that event; its timeline then counts from the tick the
# event happened at. start <event> records that tick.
event_file() { printf '%s/state/started/%s' "$DIR" "$(printf '%s' "$1" | tr '/:' '__')"; }
start() {
  mkdir -p "$DIR/state/started"
  [ -f "$(event_file "$1")" ] || tick > "$(event_file "$1")"
}
starts_on() { jq -r '.startsOn // ""' "$DIR/runs/$1/run.json"; }

run_exists() {
  [ -f "$DIR/runs/$1/run.json" ] && [ -f "$DIR/runs/$1/timeline.jsonl" ] || return 1
  local ev
  ev="$(starts_on "$1")"
  [ -z "$ev" ] || [ -f "$(event_file "$ev")" ]
}

# run_json <id>: the run's static fields merged with its state at the current tick.
run_json() {
  local id="$1" t n ev
  run_exists "$id" || die "could not find any workflow run with ID $id"
  n="$(timeline_len "$id")"
  [ "$n" -gt 0 ] || die "scenario error: runs/$id/timeline.jsonl is empty"
  t="$(tick)"
  ev="$(starts_on "$id")"
  [ -n "$ev" ] && t=$((t - $(cat "$(event_file "$ev")")))
  [ "$t" -lt 1 ] && t=1
  [ "$t" -gt "$n" ] && t="$n"
  jq -c --argjson snap "$(grep . "$DIR/runs/$id/timeline.jsonl" | sed -n "${t}p")" \
    '. * $snap | .conclusion = (.conclusion // "")' "$DIR/runs/$id/run.json"
}

run_ids() {
  local d
  for d in "$DIR"/runs/*/; do
    run_exists "$(basename "$d")" && basename "$d"
  done | sort -rn
}

# jq filter for a run as plain text, as `gh run view` prints it.
RUN_TEXT='def icon: if .status != "completed" then (if .status == "in_progress" then "*" else "-" end)
  elif .conclusion == "success" then "✓" elif .conclusion == "skipped" then "-" else "X" end;
    "\(icon) \(.headBranch) \(.workflowName) · \(.databaseId)",
    "Triggered via \(.event)",
    "Status: \(.status)\(if .conclusion != "" then " (" + .conclusion + ")" else "" end)",
    "",
    "JOBS",
    (.jobs[]? | "\(icon) \(.name) (ID \(.databaseId))",
      (if .conclusion == "failure" then (.steps[]? | select(.conclusion == "failure") | "  X \(.name)") else empty end)),
    "",
    "View this run on GitHub: \(.url)"'

# --- commands ---

cmd_run_list() {
  parse "R/repo= q/jq= -/json= w/workflow= b/branch= c/commit= L/limit= s/status= e/event= u/user= -/created= a/all" "$@"
  advance
  local id runs
  runs="$(for id in $(run_ids); do run_json "$id" || exit 1; done | jq -sc \
    --arg wf "$(opt workflow)" --arg br "$(opt branch)" --arg c "$(opt commit)" \
    --arg st "$(opt status)" --arg ev "$(opt event)" --arg lim "$(opt limit)" '
    map(select(($wf == "" or .workflowName == $wf or (.path // "") == $wf or ((.path // "") | endswith("/" + $wf)))
      and ($br == "" or .headBranch == $br) and ($c == "" or .headSha == $c)
      and ($st == "" or .status == $st or .conclusion == $st) and ($ev == "" or .event == $ev)))
    | .[:(if $lim == "" then 20 else ($lim | tonumber) end)]')" || exit 1
  show "$runs" '.[] | [.status, .conclusion, .displayTitle, .workflowName, .headBranch, .event, (.databaseId | tostring)] | @tsv'
}

# log_for <id> <file>: prints a canned log once the run has completed.
log_for() {
  local id="$1" file="$2" status
  status="$(run_json "$id" | jq -r .status)" || exit 1
  [ "$status" = completed ] || die "run $id is still in progress; logs will be available when it is complete"
  [ -f "$DIR/runs/$id/$file" ] || die "no logs found for run $id"
  cat "$DIR/runs/$id/$file"
}

cmd_run_view() {
  parse "R/repo= q/jq= -/json= t/template= j/job= a/attempt= -/log -/log-failed v/verbose -/exit-status w/web" "$@"
  reject template web
  local id="$POS1" job run file
  file=""
  has_opt log && file=log.txt
  has_opt log-failed && file=log-failed.txt
  job="$(opt job)"
  if [ -n "$job" ]; then
    [ -n "$file" ] || die "--job is only supported with --log or --log-failed"
    for run in $(run_ids); do
      if run_json "$run" | jq -e --arg j "$job" 'any(.jobs[]?; (.databaseId | tostring) == $j)' >/dev/null; then
        id="$run"
      fi
    done
    [ -n "$id" ] || die "could not find job $job"
    # A job's own canned log if there is one, else the run-level log.
    if [ "$file" = log.txt ] && [ -f "$DIR/runs/$id/jobs/$job.log" ]; then
      file="jobs/$job.log"
    elif [ "$file" = log-failed.txt ] && [ -f "$DIR/runs/$id/jobs/$job.failed.log" ]; then
      file="jobs/$job.failed.log"
    fi
  fi
  [ -n "$id" ] || die "run ID required"
  if [ -n "$file" ]; then
    log_for "$id" "$file"
    return
  fi
  advance
  local j
  j="$(run_json "$id")" || exit 1
  show "$j" "$RUN_TEXT"
  if has_opt exit-status; then
    jq -e '.status != "completed" or .conclusion == "success"' <<<"$j" >/dev/null || exit 1
  fi
}

cmd_run_watch() {
  parse "R/repo= i/interval= -/exit-status -/compact" "$@"
  local id="$POS1" n j
  [ -n "$id" ] || die "run ID required"
  run_exists "$id" || die "could not find any workflow run with ID $id"
  n="$(timeline_len "$id")"
  [ "$(tick)" -lt "$n" ] && echo "$n" > "$DIR/state/tick"
  j="$(run_json "$id")" || exit 1
  jq -r "$RUN_TEXT" <<<"$j"
  jq -r '"Run \(.workflowName) (\(.databaseId)) completed with '"'"'\(.conclusion)'"'"'"' <<<"$j"
  if has_opt exit-status; then
    jq -e '.conclusion == "success"' <<<"$j" >/dev/null || exit 1
  fi
}

# --- pull requests ---
# Canned PRs live in prs/<n>.json; PRs the agent opens or merges are written to
# state/prs/<n>.json, which wins over the canned copy.

pr_file() {
  if [ -f "$DIR/state/prs/$1.json" ]; then
    echo "$DIR/state/prs/$1.json"
  elif [ -f "$DIR/prs/$1.json" ]; then
    echo "$DIR/prs/$1.json"
  fi
}

all_prs() {
  local f n
  for f in "$DIR"/prs/*.json "$DIR"/state/prs/*.json; do
    if [ -f "$f" ]; then basename "$f" .json; fi
  done | sort -un | while read -r n; do jq -c . "$(pr_file "$n")"; done | jq -sc .
}

# A git next to the fake (a fixture's wrapper for sandboxes where plain git
# fails), else git on PATH.
GIT="$(dirname "$0")/git"
[ -x "$GIT" ] || GIT=git
current_branch() { "$GIT" rev-parse --abbrev-ref HEAD 2>/dev/null; }

# pr_json <number | branch | "">: a PR by number, else the open PR for a branch
# (the current git branch when empty).
pr_json() {
  local ref="$1" f p
  case "$ref" in
    '' | *[!0-9]*)
      [ -n "$ref" ] || ref="$(current_branch)"
      p="$(all_prs | jq -c --arg b "$ref" '[.[] | select(.headRefName == $b and .state == "OPEN")][0] // empty')"
      [ -n "$p" ] || die "no pull requests found for branch \"$ref\""
      echo "$p"
      ;;
    *)
      f="$(pr_file "$ref")"
      [ -n "$f" ] || die "GraphQL: Could not resolve to a PullRequest with the number of $ref."
      jq -c . "$f"
      ;;
  esac
}

save_pr() {
  mkdir -p "$DIR/state/prs"
  jq -c . <<<"$1" > "$DIR/state/prs/$(jq -r .number <<<"$1").json"
}

cmd_pr_view() {
  parse "R/repo= q/jq= -/json= t/template= c/comments w/web" "$@"
  reject template web
  local p
  p="$(pr_json "$POS1")" || exit 1
  show "$p" '"\(.title) #\(.number)", "\(.state)", "", "\(.body // "")", "", "View this pull request on GitHub: \(.url)"'
}

cmd_pr_list() {
  parse "R/repo= q/jq= -/json= H/head= B/base= s/state= L/limit= A/author= l/label= S/search= a/assignee= d/draft w/web" "$@"
  reject web
  local p
  p="$(all_prs | jq -c --arg h "$(opt head)" --arg b "$(opt base)" --arg s "$(opt state)" --arg lim "$(opt limit)" '
    ($s | ascii_upcase) as $st
    | map(select(($h == "" or .headRefName == $h) and ($b == "" or .baseRefName == $b)
      and (if $st == "ALL" then true elif $st == "" then .state == "OPEN" else .state == $st end)))
    | sort_by(-.number) | .[:(if $lim == "" then 30 else ($lim | tonumber) end)]')" || exit 1
  show "$p" '.[] | [(.number | tostring), .title, .headRefName, .state] | @tsv'
}

cmd_pr_create() {
  parse "R/repo= t/title= b/body= F/body-file= B/base= H/head= d/draft f/fill l/label= a/assignee= r/reviewer= m/milestone= p/project= w/web" "$@"
  reject web fill
  local head base body n url existing
  [ -n "$(opt title)" ] && { has_opt body || has_opt body-file; } \
    || die "must provide --title and --body (or --body-file) when not running interactively"
  head="$(opt head)"
  [ -n "$head" ] || head="$(current_branch)"
  [ -n "$head" ] || die "could not determine the current branch; pass --head"
  base="$(opt base)"
  [ -n "$base" ] || base="$DEFAULT_BRANCH"
  body="$(read_body)" || exit 1
  existing="$(all_prs | jq -r --arg h "$head" --arg b "$base" '[.[] | select(.headRefName == $h and .baseRefName == $b and .state == "OPEN")][0].url // empty')"
  [ -z "$existing" ] || die "a pull request for branch \"$head\" into branch \"$base\" already exists:
$existing"
  n="$(cat "$DIR/state/next-pr" 2>/dev/null || cat "$DIR/next-pr" 2>/dev/null || echo 100)"
  echo $((n + 1)) > "$DIR/state/next-pr"
  url="https://github.com/$REPO/pull/$n"
  save_pr "$(jq -nc --argjson n "$n" --arg t "$(opt title)" --arg b "$body" --arg h "$head" --arg base "$base" \
    --arg u "$url" --argjson d "$(has_opt draft && echo true || echo false)" \
    --arg oid "$("$GIT" rev-parse --verify -q "$head" 2>/dev/null)" \
    '{number: $n, title: $t, body: $b, state: "OPEN", isDraft: $d, mergeable: "MERGEABLE", mergeStateStatus: "CLEAN",
      headRefName: $h, headRefOid: $oid, baseRefName: $base, mergeCommit: null, url: $u}')"
  start "pr-open:$head"
  echo "$url"
}

# merge_sha <branch>: the headSha of the run that starts when that branch merges.
merge_sha() {
  local d
  for d in "$DIR"/runs/*/; do
    if [ -f "$d/run.json" ] && [ "$(starts_on "$(basename "$d")")" = "merge:$1" ]; then
      jq -r .headSha "$d/run.json"
      return
    fi
  done
}

cmd_pr_edit() {
  parse "R/repo= t/title= b/body= F/body-file= B/base= -/add-label= -/remove-label= -/add-reviewer= -/add-assignee=" "$@"
  local p body
  p="$(pr_json "$POS1")" || exit 1
  if has_opt body || has_opt body-file; then
    body="$(read_body)" || exit 1
    p="$(jq -c --arg b "$body" '.body = $b' <<<"$p")"
  fi
  has_opt title && p="$(jq -c --arg t "$(opt title)" '.title = $t' <<<"$p")"
  has_opt base && p="$(jq -c --arg b "$(opt base)" '.baseRefName = $b' <<<"$p")"
  save_pr "$p"
  jq -r .url <<<"$p"
}

cmd_pr_merge() {
  parse "R/repo= s/squash m/merge r/rebase d/delete-branch -/auto -/admin t/subject= b/body= F/body-file= -/match-head-commit=" "$@"
  reject auto
  local p method head sha oid n issue verb
  method=""
  for n in squash merge rebase; do
    if has_opt "$n"; then
      [ -z "$method" ] || die "only one of --merge, --rebase, or --squash can be enabled"
      method="$n"
    fi
  done
  [ -n "$method" ] || die "--merge, --rebase, or --squash required when not running interactively"
  p="$(pr_json "$POS1")" || exit 1
  n="$(jq -r .number <<<"$p")"
  case "$(jq -r .state <<<"$p")" in
    MERGED) die "Pull request #$n was already merged" ;;
    CLOSED) die "Pull request #$n is closed" ;;
  esac
  # --match-head-commit: GitHub takes only a full 40-character SHA, and refuses
  # the merge when the PR's head has moved (a PR with no known head is let by).
  if has_opt match-head-commit; then
    sha="$(opt match-head-commit)"
    printf '%s' "$sha" | grep -Eq '^[0-9a-f]{40}$' \
      || die "GraphQL: Variable \$input of type MergePullRequestInput! was provided invalid value for expectedHeadOid (Could not coerce value \"$sha\" to GitObjectID)"
    oid="$(jq -r '.headRefOid // ""' <<<"$p")"
    [ -z "$oid" ] || [ "$oid" = "$sha" ] || die "GraphQL: Head branch was modified. Review and try the merge again. (mergePullRequest)"
  fi
  head="$(jq -r .headRefName <<<"$p")"
  sha="$(merge_sha "$head")"
  [ -n "$sha" ] || sha="$(printf '%040d' "$n")"
  save_pr "$(jq -c --arg sha "$sha" '.state = "MERGED" | .mergeCommit = {oid: $sha}' <<<"$p")"
  start "merge:$head"
  # Closing keywords in the body close issues when the PR merges into the default branch.
  if [ "$(jq -r .baseRefName <<<"$p")" = "$DEFAULT_BRANCH" ]; then
    for issue in $(jq -r '.body // "" | [scan("(?i)\\b(?:close[sd]?|fix(?:e[sd])?|resolve[sd]?):?\\s+#([0-9]+)")[0]] | .[]' <<<"$p"); do
      set_issue_state "$issue" CLOSED
    done
  fi
  case "$method" in
    squash) verb="Squashed and merged" ;;
    merge) verb="Merged" ;;
    rebase) verb="Rebased and merged" ;;
  esac
  echo "✓ $verb pull request #$n ($(jq -r .title <<<"$p"))"
  has_opt delete-branch && echo "✓ Deleted branch $head"
  return 0
}

cmd_pr_checks() {
  parse "R/repo= q/jq= -/json= i/interval= -/watch -/required -/fail-fast" "$@"
  local p branch id n max rows
  p="$(pr_json "$POS1")" || exit 1
  branch="$(jq -r .headRefName <<<"$p")"
  if has_opt watch; then
    max="$(tick)"
    for id in $(run_ids); do
      n="$(timeline_len "$id")"
      [ "$n" -gt "$max" ] && max="$n"
    done
    echo "$max" > "$DIR/state/tick"
  else
    advance
  fi
  rows="$(for id in $(run_ids); do run_json "$id" || exit 1; done | jq -sc --arg br "$branch" '
    def bucket: if .status != "completed" then "pending" elif .conclusion == "success" then "pass"
      elif (.conclusion == "skipped" or .conclusion == "neutral") then "skipping"
      elif .conclusion == "cancelled" then "cancel" else "fail" end;
    def state: (if .status == "completed" then .conclusion else .status end) | ascii_upcase;
    [ .[] | select(.headBranch == $br) | . as $run
      | if (.jobs // []) == [] then {name: .workflowName, state: state, bucket: bucket, link: .url, workflow: .workflowName}
        else (.jobs[] | {name, state: state, bucket: bucket, link: (.url // $run.url), workflow: $run.workflowName}) end ]')" || exit 1
  [ "$(jq length <<<"$rows")" -gt 0 ] || die "no checks reported on the '$branch' branch"
  show "$rows" '.[] | [.name, .bucket, "0", .link] | @tsv'
  jq -e 'any(.[]; .bucket == "fail")' <<<"$rows" >/dev/null && exit 1
  jq -e 'any(.[]; .bucket == "pending")' <<<"$rows" >/dev/null && exit 8
  exit 0
}

# Issue state changes (close, reopen, closed by a merge) are lines of
# "<number> <STATE>" in state/issue-states; the last line for an issue wins.
set_issue_state() { echo "$1 $2" >> "$DIR/state/issue-states"; }

issues_json() {
  local states
  states='{}'
  [ -f "$DIR/state/issue-states" ] && states="$(jq -Rsc 'split("\n") | map(select(. != "") | split(" ") | {(.[0]): .[1]}) | add // {}' "$DIR/state/issue-states")"
  {
    cat "$DIR/issues.json" 2>/dev/null || echo '[]'
    cat "$DIR/state/created-issues.jsonl" 2>/dev/null || true
  } | jq -sc --argjson states "$states" --argjson comments "$(issue_comments)" '(.[0]) + .[1:]
    | map(.state = ($states[.number | tostring] // .state))
    | map((.number | tostring) as $n | .comments = ((.comments // []) + [$comments[] | select(.issue == $n) | {body}]))'
}

# Comments the agent posted, from state/comments.jsonl.
issue_comments() {
  if [ -f "$DIR/state/comments.jsonl" ]; then jq -sc . "$DIR/state/comments.jsonl"; else echo '[]'; fi
}

cmd_issue_list() {
  parse "R/repo= q/jq= -/json= S/search= s/state= l/label= a/assignee= A/author= L/limit= m/milestone= -/app=" "$@"
  local i
  case "$(opt state)" in
    '' | open | closed | all) ;;
    *) die "invalid argument \"$(opt state)\" for \"-s, --state\" flag: valid values are {open|closed|all}" ;;
  esac
  # Repeated or comma-separated labels must all be on the issue, ignoring case;
  # newest first, as gh lists them.
  i="$(issues_json | jq -c --arg s "$(opt state)" --arg l "$(opt_all label | tr '\n' ',')" --arg lim "$(opt limit)" '
    ($s | ascii_upcase) as $st
    | ($l | ascii_downcase | split(",") | map(select(. != ""))) as $want
    | map(select(if $st == "ALL" then true elif $st == "" then .state == "OPEN" else .state == $st end)
      | select(([(.labels // [])[].name | ascii_downcase]) as $have | all($want[]; . as $w | $have | index([$w]))))
    | sort_by(-.number) | .[:(if $lim == "" then 30 else ($lim | tonumber) end)]')" || exit 1
  show "$i" '.[] | [(.number | tostring), .state, .title] | @tsv'
}

cmd_issue_view() {
  parse "R/repo= q/jq= -/json= t/template= c/comments w/web" "$@"
  reject template web
  local i
  i="$(issues_json | jq -c --arg n "$POS1" '.[] | select((.number | tostring) == $n)')"
  [ -n "$i" ] || die "GraphQL: Could not resolve to an issue or pull request with the number of $POS1."
  show "$i" '"\(.title) #\(.number)", "\(.state)", "", "\(.body // "")", "", "View this issue on GitHub: \(.url)"'
}

cmd_issue_create() {
  parse "R/repo= t/title= b/body= F/body-file= l/label= a/assignee= m/milestone= p/project= T/template= w/web" "$@"
  reject web
  [ -n "$(opt title)" ] || die "must provide --title and --body when not running interactively"
  local n url
  n="$(cat "$DIR/state/next-issue" 2>/dev/null || echo 101)"
  echo $((n + 1)) > "$DIR/state/next-issue"
  url="https://github.com/$REPO/issues/$n"
  jq -nc --argjson n "$n" --arg t "$(opt title)" --arg b "$(opt body)" --arg u "$url" \
    '{number: $n, title: $t, body: $b, state: "OPEN", url: $u}' >> "$DIR/state/created-issues.jsonl"
  echo "$url"
}

cmd_issue_close() {
  parse "R/repo= c/comment= r/reason=" "$@"
  local i
  i="$(issues_json | jq -c --arg n "$POS1" '.[] | select((.number | tostring) == $n)')"
  [ -n "$i" ] || die "GraphQL: Could not resolve to an issue or pull request with the number of $POS1."
  if [ "$(jq -r .state <<<"$i")" = CLOSED ]; then
    echo "! Issue #$POS1 ($(jq -r .title <<<"$i")) is already closed"
    return 0
  fi
  set_issue_state "$POS1" CLOSED
  has_opt comment && add_comment "$POS1" "$(opt comment)"
  echo "✓ Closed issue #$POS1 ($(jq -r .title <<<"$i"))"
}

cmd_issue_reopen() {
  parse "R/repo= c/comment=" "$@"
  local i
  i="$(issues_json | jq -c --arg n "$POS1" '.[] | select((.number | tostring) == $n)')"
  [ -n "$i" ] || die "GraphQL: Could not resolve to an issue or pull request with the number of $POS1."
  set_issue_state "$POS1" OPEN
  has_opt comment && add_comment "$POS1" "$(opt comment)"
  echo "✓ Reopened issue #$POS1 ($(jq -r .title <<<"$i"))"
}

# add_comment <issue> <body>: records a comment; prints its URL.
add_comment() {
  jq -nc --arg i "$1" --arg b "$2" '{issue: $i, body: $b}' >> "$DIR/state/comments.jsonl"
  echo "https://github.com/$REPO/issues/$1#issuecomment-$((900000 + $(grep -c . "$DIR/state/comments.jsonl")))"
}

cmd_issue_comment() {
  parse "R/repo= b/body= F/body-file= e/editor w/web" "$@"
  reject editor web
  local body
  issues_json | jq -e --arg n "$POS1" 'any(.[]; (.number | tostring) == $n)' >/dev/null \
    || die "GraphQL: Could not resolve to an issue or pull request with the number of $POS1."
  body="$(read_body)" || exit 1
  [ -n "$body" ] || die "--body or --body-file required when not running interactively"
  add_comment "$POS1" "$body"
}

# Workflows are the ones the scenario's runs belong to, all active.
cmd_workflow_list() {
  parse "R/repo= q/jq= -/json= a/all L/limit=" "$@"
  local w
  w="$(for d in "$DIR"/runs/*/; do if [ -f "$d/run.json" ]; then jq -c . "$d/run.json"; fi; done | jq -sc '
    [.[] | {name: .workflowName, path}] | unique_by(.path)
    | to_entries | map(.value + {id: (.key + 1), state: "active"})')"
  show "$w" '.[] | [.name, .state, (.id | tostring)] | @tsv'
}

case "${1:-} ${2:-}" in
  "run list") shift 2; cmd_run_list "$@" ;;
  "run view") shift 2; cmd_run_view "$@" ;;
  "run watch") shift 2; cmd_run_watch "$@" ;;
  "pr create") shift 2; cmd_pr_create "$@" ;;
  "pr list") shift 2; cmd_pr_list "$@" ;;
  "pr view") shift 2; cmd_pr_view "$@" ;;
  "pr merge") shift 2; cmd_pr_merge "$@" ;;
  "pr edit") shift 2; cmd_pr_edit "$@" ;;
  "pr checks") shift 2; cmd_pr_checks "$@" ;;
  "issue list") shift 2; cmd_issue_list "$@" ;;
  "issue view") shift 2; cmd_issue_view "$@" ;;
  "issue create") shift 2; cmd_issue_create "$@" ;;
  "issue close") shift 2; cmd_issue_close "$@" ;;
  "issue comment") shift 2; cmd_issue_comment "$@" ;;
  "issue reopen") shift 2; cmd_issue_reopen "$@" ;;
  "workflow list") shift 2; cmd_workflow_list "$@" ;;
  "auth status")
    echo "github.com"
    echo "  ✓ Logged in to github.com account fixture-user (stand-in CLI)"
    ;;
  "--version "* | "version "*) echo "gh version 2.0.0 (stand-in CLI for evals)" ;;
  *) die "unsupported in this sandbox: gh $*. Supported: $SUPPORTED" ;;
esac
